# Backend Production Environment Variables
# For use in Railway.app Dashboard
# Generate a real random string for SECRET_KEY (e.g., using 'openssl rand -hex 32')

PROJECT_NAME="Dairy Management System"
SENTRY_ENVIRONMENT="production"
API_V1_STR="/api/v1"

# Database - Railway will override this if you use their Postgres service
# DATABASE_URL="postgresql+asyncpg://user:password@host:port/dbname"

# Security
SECRET_KEY="REPLACE_WITH_SECURE_RANDOM_STRING"
ALGORITHM="HS256"

# CORS - Add your Vercel URL here after deployment
# BACKEND_CORS_ORIGINS=["https://dairyday.vercel.app"]

# AI
AI_MODEL="stepfun/step-3.5-flash:free"
# AI_API_KEY from .env

# Payments
# RAZORPAY_KEY_ID=...
# RAZORPAY_KEY_SECRET=...
