# Dairy Management System - Environment Configuration
# Copy this file to .env and fill in the values

# Database Configuration (Supabase PostgreSQL)
# DATABASE_URL=postgresql://postgres.piihwvvysfemcwtbgnyn:y0Crrbe6KGvE-uPxrOvcGw_gvKIKW7_@aws-0-ap-south-1.pooler.supabase.com:6543/postgres
# POSTGRES_SERVER=localhost
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=password
# POSTGRES_DB=dairy_db
DATABASE_URL=sqlite+aiosqlite:///./dairy.db
# For Supabase (Transaction Pooler - Recommended for Serverless):
# DATABASE_URL=postgresql://postgres.your-ref:your-password@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true

# Redis Configuration
REDIS_URL=redis://127.0.0.1:6379/0

# Security Settings
# Generate a strong secret key: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=B99B8G-rvK7u5hiaxymxLLrwO5c7tu3q-xi9nDP5qcZKKCd5x0pW0zWr1VhJS5wXU_TU0Bwqw4GK-hOvrXeanGw
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Lock Days - Number of days after which consumption entries become immutable
LOCK_DAYS=7

# Rate Limiting
RATE_LIMIT=100/minute

# AWS/S3 Configuration (for PDF storage)
# For local development with MinIO:
# AWS_ENDPOINT_URL=http://127.0.0.1:9000
AWS_REGION=us-east-1
AWS_BUCKET_NAME=dairy-bills
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_ENDPOINT_URL=http://127.0.0.1:9000

# Razorpay Payment Gateway Configuration
# Get these from your Razorpay dashboard: https://dashboard.razorpay.com/
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_key_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# CORS Origins (comma-separated URLs)
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:3001","http://localhost:3002","http://localhost:3003","http://localhost:3004","http://localhost:5173","http://127.0.0.1:3000","http://127.0.0.1:3001","http://127.0.0.1:3002","http://127.0.0.1:3003","http://127.0.0.1:3004","http://127.0.0.1:5173"]

# Optional: Sentry DSN for error tracking
# SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
SENTRY_DSN=

# AI OpenRouter Configuration
AI_API_KEY=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
AI_MODEL=qwen/qwen3-next-80b-a3b-instruct:free
